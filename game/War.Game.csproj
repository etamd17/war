<Project Sdk="Godot.NET.Sdk/4.7.1">

  <!--
    The Sdk version above must match the installed engine exactly. If you upgrade Godot,
    change it: the version is written on the tin, and the engine also ships the matching
    package at GodotSharp/Tools/nupkgs/ if you ever need to confirm it.

    TargetFramework stays net8.0 because that is what GodotSharp itself is built against
    (its nupkg ships lib/net8.0 and nothing else). War.Sim multi-targets net8.0 and
    net10.0 precisely so this project and the test project can each take the one they
    need without either constraining the other.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <RootNamespace>War.Game</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The one-way dependency that the whole architecture rests on: the game knows about
      the simulation, and the simulation knows nothing about Godot. No game rule may
      live on this side of the line.
    -->
    <ProjectReference Include="..\sim\War.Sim\War.Sim.csproj" />
  </ItemGroup>

</Project>
