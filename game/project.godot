; Godot project configuration for WAR.
;
; The entire scene tree is built in code from Main.cs rather than authored as .tscn
; files. That keeps the game's structure reviewable in source control as C# rather than
; as generated scene diffs, and means the whole presentation layer can be reasoned about
; by reading one file instead of clicking through an editor.
;
; Deliberately minimal. Every line here is hand-written and was never loaded by the
; editor, so anything not strictly needed is a chance to fail on open for no benefit.
; Input is read directly from key codes in Main.cs, so there are no input actions to
; declare and no serialised InputEvent blobs to get wrong.

config_version=5

[application]

config/name="WAR"
config/description="Real-time ancient battle tactics."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")

[dotnet]

project/assembly_name="War.Game"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
