<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The battle simulation. Deliberately has ZERO Godot references and zero
    dependencies of any kind: it must be runnable headless, in tests, and in
    batch balance sweeps. Godot 4.5 .NET consumes the net8.0 target; the test
    project runs on net10.0, which is the SDK actually installed here.

    Nothing in this project may call System.Math, System.Random, DateTime, or
    anything else non-deterministic. See Core/ for the replacements.
  -->

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>War.Sim</RootNamespace>
    <AssemblyName>War.Sim</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

</Project>
